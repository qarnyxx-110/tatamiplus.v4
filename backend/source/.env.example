DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-local-development-key-do-not-use-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite

# Leave SMS_BACKEND unset in development: OTP codes are printed to the runserver
# console. Set it to a real backend path before DJANGO_DEBUG=0.
# SMS_BACKEND=accounts.sms.ConsoleSMSBackend

# Payments run through the local mock gateway until a provider is chosen.
# PAYMENT_GATEWAY=orders.gateways.mock.MockGateway
# The real flat shipping price still has to be confirmed.
# SHIPPING_FLAT_RATE=50000

# Course videos are private. Django streams them by default; behind Nginx, map
# /protected/ to PRIVATE_UPLOAD_ROOT and turn this on to hand off the transfer.
# COURSE_VIDEO_MAX_BYTES=1073741824
# USE_X_ACCEL_REDIRECT=False