  "family": "Vazirmatn, \"Segoe UI\", Tahoma, \"Noto Sans Arabic\", system-ui, sans-serif",
  "size-xs": ".75rem",
  "size-caption": ".8125rem",
  "size-sm": ".875rem",
  "size-base": "1rem",
  "size-lg": "1.125rem",
  "size-xl": "1.25rem",
  "size-2xl": "1.5rem",
  "size-3xl": "1.875rem",
